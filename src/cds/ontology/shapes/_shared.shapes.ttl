# Shared SPARQL prefix declarations, referenced by sh:sparql constraints via sh:prefixes.
# Shapes are not part of the canonical (deterministic) data build, so blank nodes are fine here.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cdsh: <https://w3id.org/cds/shapes#> .

cdsh:prefixes
    sh:declare [ sh:prefix "cds"  ; sh:namespace "https://w3id.org/cds#"^^xsd:anyURI ] ,
               [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
               [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] .
