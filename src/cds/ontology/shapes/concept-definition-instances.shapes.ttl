@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix cds:     <https://w3id.org/cds#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Shapes for a user's authored concept-definition INSTANCES (not the reference vocabulary).
# Every record carries the cds:Instance marker; the mapping container is a cds:Synthesis.
# Property shapes are IRIs (not blank nodes) so `cds verify` reports a readable rule name.

cds:instanceHasLabel a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "an instance needs exactly one rdfs:label (its short name)" .

cds:instanceHasDescription a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "an instance needs exactly one dcterms:description (its content statement)" .

cds:instanceInSynthesis a sh:PropertyShape ;
    sh:path cds:inSynthesis ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "every instance must belong to a cds:Synthesis (its mapping)" .

cds:InstanceShape a sh:NodeShape ;
    sh:targetClass cds:Instance ;
    sh:property cds:instanceHasLabel ;
    sh:property cds:instanceHasDescription ;
    sh:property cds:instanceInSynthesis .

# ADR-9 lifecycle markers — one shape guards the append-only invariant: the marker is a
# single boolean (a second value means someone tried to flip or re-mark it in place).

cds:retractedMarkerWellFormed a sh:PropertyShape ;
    sh:path cds:retracted ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
    sh:severity sh:Violation ;
    sh:message "cds:retracted is an append-only marker: at most one xsd:boolean value (ADR-9)" .

cds:retractionReasonWellFormed a sh:PropertyShape ;
    sh:path cds:retractionReason ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Violation ;
    sh:message "cds:retractionReason: at most one string (ADR-9)" .

cds:LifecycleMarkerShape a sh:NodeShape ;
    sh:targetSubjectsOf cds:retracted ;
    sh:property cds:retractedMarkerWellFormed ;
    sh:property cds:retractionReasonWellFormed .

# ADR-9 R7 — positions: a stance must name its holder, its subject, and exactly one stance.
# NO shape constrains positions on the same target to agree: divergence is valid (X2-lite).

cds:positionCharacterizes a sh:PropertyShape ;
    sh:path cds:characterizes ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "a position must characterize a record (cds:characterizes)" .

cds:positionHeldBy a sh:PropertyShape ;
    sh:path cds:heldBy ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "a position must name its holder (cds:heldBy a stakeholder)" .

cds:positionStance a sh:PropertyShape ;
    sh:path cds:stance ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "a position takes exactly one stance (supports/opposes/prioritizes/constrains/reads-as)" .

cds:PositionShape a sh:NodeShape ;
    sh:targetClass cds:Position ;
    sh:property cds:positionCharacterizes ;
    sh:property cds:positionHeldBy ;
    sh:property cds:positionStance .

cds:synthesisHasLabel a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "a cds:Synthesis needs exactly one rdfs:label (its title)" .

cds:SynthesisShape a sh:NodeShape ;
    sh:targetClass cds:Synthesis ;
    sh:property cds:synthesisHasLabel .
