cdsterm:capability
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "DoD 2009" ;
    cds:sysmlConstruct sysml:UseCaseDefinition ;
    skos:definition "The ability to achieve a desired effect under specified (performance) standards and conditions through combinations of ways and means (activities and resources) to perform a set of activities." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Capability_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Capability" .

cdsterm:concept-definition
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Created for SEBoK" ;
    skos:definition "A set of core technical activities of systems engineering in which the problem space and the needs of the stakeholders are closely examined. This consists of analysis of the problem space and definition of stakeholder needs for required services within it." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Concept_Definition_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Concept Definition" .

cdsterm:engineered-system
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Created for SEBoK" ;
    skos:definition "An open, concrete system of technical or socio-technical elements which is the focus of a SE Life Cycle. Its characteristics include being created by and for people, having a purpose and satisfying key stakeholders’ value propositions when considered as part of a broader System Context." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Engineered_System_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Engineered System" .

cdsterm:function
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Ackoff 1971" ;
    skos:definition "A system outcomes which contribute to goals or objectives. To have a function, a system must be able to provide the outcome through two or more different combinations of elemental behavior." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Function_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Function" .

cdsterm:functional-architecture
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Created for SEBoK" ;
    skos:definition "A functional architecture is a set of functions and their sub-functions that defines the transformations of input flows into output flows performed by the system to achieve its mission." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Functional_Architecture_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Functional Architecture" .

cdsterm:life-cycle
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Pyster 2009, 73" ;
    skos:definition "The organized collection of activities, relationships and contracts which apply to a system-of-interest during its life." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Life_Cycle_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Life Cycle" .

cdsterm:logical-architecture
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Created for SEBoK" ;
    skos:definition "The logical architecture of a system is composed of a set of related technical concepts and principles that support the logical operation of the system. It includes a functional architecture, a behavioral architecture, and a temporal architecture." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Logical_Architecture_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Logical Architecture" .

cdsterm:mbse
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "INCOSE 2007" ;
    skos:altLabel "MBSE" ;
    skos:definition "The formalized application of modeling to support system requirements, design, analysis, verification and validation activities beginning in the conceptual design phase and continuing throughout development and later life cycle phases." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Model-Based_Systems_Engineering_(MBSE)_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Model-Based Systems Engineering" .

cdsterm:measure-of-effectiveness
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "IEEE 2005" ;
    skos:altLabel "MoE" ;
    skos:definition "The metrics by which an acquirer will measure satisfaction with products produced by the technical effort." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Measure_of_Effectiveness_(MoE)_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Measure of Effectiveness" .

cdsterm:mission
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Created for SEBoK" ;
    cds:sysmlConstruct sysml:UseCaseDefinition ;
    skos:definition "The mission of a system is the top-level function of the system; the one that synthesizes all transformation of all inputs and solicitations into outputs and reactions." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Mission_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Mission" .

cdsterm:mission-analysis
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "modified from Blanchard and Fabryky 2011" ;
    skos:definition "Examination and definition of the primary and secondary purposes of a system." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Mission_Analysis_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Mission Analysis" .

cdsterm:need
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:closeMatch <https://sebokwiki.org/wiki/Need_(glossary)> ;
    skos:definition "A need statement is the result of a formal transformation of one or more sources or lifecycle concepts into an agreed-to expectation for an entity to perform some function or possess some quality within specified constraints with acceptable risk." ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Need" .

cdsterm:operational-concept
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "ANSI/AIAA G-043-199" ;
    skos:definition "verbal and graphic statement of an organization’s assumptions or intent in regard to an operation or series of operations of a system or a related set of systems." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Operational_Concept_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Operational Concept" .

cdsterm:opportunity
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Dictionary.com 2012" ;
    skos:definition "an appropriate or favorable time or occasion; a situation or condition favorable for attainment of a goal; a good position, chance, or prospect, as for advancement or success." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Opportunity_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Opportunity" .

cdsterm:problem
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Conrow 2008" ;
    skos:definition "A concern that has a probability of occurrence equal to one, a consequence of occurrence greater than zero, and a time-frame that is current. A problem is an event that has occurred and has a negative impact to the project." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Problem_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Problem" .

cdsterm:requirement
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:closeMatch <https://sebokwiki.org/wiki/Requirement_(glossary)> ;
    skos:definition "A requirement statement is the result of a formal transformation of one or more sources, needs, or higher-level requirements into an agreed-to obligation for an entity to perform some function or possess some quality within specified constraints with acceptable risk." ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Requirement" .

cdsterm:risk
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Conrow 2008" ;
    skos:definition "A risk has a probability of occurrence that is greater than zero but less than one, a consequence of occurrence greater than zero, and a time-frame in the future." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Risk_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Risk" .

cdsterm:solution
    a cds:Term,
        skos:Concept ;
    cds:addresses cdsterm:opportunity,
        cdsterm:problem,
        cdsterm:threat ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "American Heritage Dictionary 2009" ;
    skos:definition "A means of solving a problem or dealing with a difficult situation." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Solution_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Solution" .

cdsterm:stakeholder
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "ISO/IEC/IEEE 2015" ;
    skos:definition "Individual or organization having a right, share, claim, or interest in a system or in its possession of characteristics that meet their needs and expectations" ;
    skos:exactMatch <https://sebokwiki.org/wiki/Stakeholder_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Stakeholder" .

cdsterm:stakeholder-needs-and-requirements
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "ISO/IEC/IEEE 15288, 2023, Section 6.4.2" ;
    cds:sysmlConstruct sysml:RequirementDefinition ;
    skos:definition "Stakeholder needs include elicitation of needs, wants, desires, expectations and perceived constraints of identified stakeholders. Needs concentrate on system purpose and behavior, and are described in the context of the operational environment and conditions." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Stakeholder_Needs_and_Requirements_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Stakeholder Needs and Requirements" .

cdsterm:system-boundary
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Checkland 1999, 312" ;
    skos:definition "A distinction made by an observer which marks the difference between an entity he takes to be a system and its environment." ;
    skos:exactMatch <https://sebokwiki.org/wiki/System_Boundary_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "System Boundary" .

cdsterm:system-context
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Flood and Carson 1993" ;
    skos:definition "Describes the system relationships and environment, resolved around a selected system-of-interest." ;
    skos:exactMatch <https://sebokwiki.org/wiki/System_Context_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "System Context" .

cdsterm:system-definition
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "Created for SEBoK" ;
    skos:definition "A set of core technical activities of systems engineering, including the activities that are completed primarily in the front-end portion of the system design. This consists of the definition of system requirements, the design of one or more logical and physical architectures, and analysis and selection between possible solution options." ;
    skos:exactMatch <https://sebokwiki.org/wiki/System_Definition_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "System Definition" .

cdsterm:system-of-interest
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "ISO/IEC/IEEE 2015" ;
    cds:sysmlConstruct sysml:PartDefinition ;
    skos:altLabel "SoI" ;
    skos:definition "The system whose life cycle is under consideration." ;
    skos:exactMatch <https://sebokwiki.org/wiki/System-of-Interest_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "System-of-Interest" .

cdsterm:system-requirement
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "ISO/IEC/IEEE, 2015, section 6.4.2" ;
    cds:sysmlConstruct sysml:RequirementDefinition ;
    skos:definition "A statement that transforms the stakeholder, user-oriented view of desired capabilities into a technical view, of a solution that meets the operational needs of the user." ;
    skos:exactMatch <https://sebokwiki.org/wiki/System_Requirement_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "System Requirement" .

cdsterm:threat
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "ISO/IEC/IEEE 2011" ;
    skos:definition "State of the system or system environment which can lead to adverse effects." ;
    skos:exactMatch <https://sebokwiki.org/wiki/Threat_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Threat" .

cdsterm:traceability
    a cds:Term,
        skos:Concept ;
    cds:cites <https://w3id.org/cds/src/sebok-v2-14> ;
    cds:definitionSource "IEEE 1233-1998 (R2002), 3.1.9" ;
    skos:definition "The degree to which a relationship can be established between two or more products of the development process, especially products having a predecessor-successor or master-subordinate relationship to one another" ;
    skos:exactMatch <https://sebokwiki.org/wiki/Traceability_(glossary)> ;
    skos:inScheme <https://w3id.org/cds/scheme/concept-definition> ;
    skos:prefLabel "Traceability" .

omg-sysml:PartDefinition
    a owl:Class .

omg-sysml:RequirementDefinition
    a owl:Class .

omg-sysml:UseCaseDefinition
    a owl:Class .

sysml:PartDefinition
    a owl:Class ;
    owl:equivalentClass omg-sysml:PartDefinition .

sysml:RequirementDefinition
    a owl:Class ;
    owl:equivalentClass omg-sysml:RequirementDefinition .

sysml:UseCaseDefinition
    a owl:Class ;
    owl:equivalentClass omg-sysml:UseCaseDefinition .
