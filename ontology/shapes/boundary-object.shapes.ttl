# Boundary-object (ASoT) shapes: authority + source well-formedness and the
# authority-before-source construction-order precondition.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cds:  <https://w3id.org/cds#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cdsh: <https://w3id.org/cds/shapes#> .

cdsh:AuthorityShape a sh:NodeShape ;
    sh:targetClass cds:Authority ;
    sh:property [
        sh:path rdfs:label ; sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "T1: an authority must carry an rdfs:label." ] ;
    sh:property [
        sh:path cds:authorityKind ; sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "T1: an authority must declare a cds:authorityKind." ] .

cdsh:SourceShape a sh:NodeShape ;
    sh:targetClass cds:Source ;
    # construction order, stage 1 before 2: a source must attribute to a *registered* authority
    sh:property [
        sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:class cds:Authority ;
        sh:severity sh:Violation ;
        sh:message "T1: a source must be attributed (prov:wasAttributedTo) to a registered cds:Authority — construction order stage 1 precedes stage 2." ] ;
    sh:property [
        sh:path cds:locator ; sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "T1: a source must carry a cds:locator." ] ;
    sh:property [
        sh:path cds:sourceType ; sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "T1: a source must declare a cds:sourceType." ] ;
    sh:property [
        sh:path cds:captureTier ; sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "T1: a source must declare a cds:captureTier." ] ;
    # licenses are tracked, not enforced — absence is an auditability gap, not a violation
    sh:property [
        sh:path cds:license ; sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "T2: a source has no tracked cds:license — its usage cannot be audited (licenses are tracked, not enforced)." ] .
