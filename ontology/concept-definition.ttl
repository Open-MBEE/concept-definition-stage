<https://w3id.org/cds/auth/incose>
    a cds:Authority,
        prov:Agent ;
    cds:authorityKind <https://w3id.org/cds#AuthorityKind/standard> ;
    rdfs:label "INCOSE (International Council on Systems Engineering)" .

<https://w3id.org/cds/auth/sebok>
    a cds:Authority,
        prov:Agent ;
    cds:authorityKind <https://w3id.org/cds#AuthorityKind/curated-canon> ;
    rdfs:label "SEBoK (Guide to the Systems Engineering Body of Knowledge)" .

<https://w3id.org/cds/characteristic/C10>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C10" ;
    skos:prefLabel "Complete" .

<https://w3id.org/cds/characteristic/C11>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C11" ;
    skos:prefLabel "Consistent" .

<https://w3id.org/cds/characteristic/C12>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C12" ;
    skos:prefLabel "Feasible" .

<https://w3id.org/cds/characteristic/C13>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C13" ;
    skos:prefLabel "Comprehensible" .

<https://w3id.org/cds/characteristic/C14>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C14" ;
    skos:prefLabel "Able to be validated" .

<https://w3id.org/cds/characteristic/C15>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C15" ;
    skos:prefLabel "Correct" .

<https://w3id.org/cds/characteristic/C1>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:definition "The need requirement statement defines capability, characteristic, constraint, or quality factor needed or required to satisfy a lifecycle concept, need, source, or higher-level requirement." ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C1" ;
    skos:prefLabel "Necessary" .

<https://w3id.org/cds/characteristic/C2>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:definition "The specific intent and amount of detail of the need or requirement statement is appropriate to the level (the level of abstraction, organization, or system architecture) of the entity to which it refers." ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C2" ;
    skos:prefLabel "Appropriate" .

<https://w3id.org/cds/characteristic/C3>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:definition "Need and requirement statements must be stated such that their intent is clear and can be interpreted in only one way by all intended audiences." ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C3" ;
    skos:prefLabel "Unambiguous" .

<https://w3id.org/cds/characteristic/C4>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:definition "The need statement sufficiently describes the necessary capability, characteristic, constraint, conditions, or quality factor to meet the lifecycle concept or source from which it was transformed. The requirement statement sufficiently describes the necessary capability, characteristic, constraint, conditions, or quality factor to meet the need, source, or higher-level requirement from which it was transformed." ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C4" ;
    skos:prefLabel "Complete" .

<https://w3id.org/cds/characteristic/C5>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:definition "The need or requirement statement should state a single capability, characteristic, constraint, or quality factor." ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C5" ;
    skos:prefLabel "Singular" .

<https://w3id.org/cds/characteristic/C6>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:definition "The need or requirement can be realized within entity constraints (for example: cost, schedule, technical, legal, ethical, safety) with acceptable risk." ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C6" ;
    skos:prefLabel "Feasible" .

<https://w3id.org/cds/characteristic/C7>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:definition "The need statement is structured and worded such that its realization can be validated to the approving authority’s satisfaction. The requirement statement is structured and worded such that its realization can be verified to the approving authority’s satisfaction." ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C7" ;
    skos:prefLabel "Verifiable" .

<https://w3id.org/cds/characteristic/C8>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:definition "The need statement must be an accurate representation of the lifecycle concept or source from which it was transformed. The requirement statement must be an accurate representation of the need, source, or higher-level requirement from which it was transformed." ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C8" ;
    skos:prefLabel "Correct" .

<https://w3id.org/cds/characteristic/C9>
    a skos:Concept ;
    cds:cites <https://w3id.org/cds/src/incose-gtwr-v4-summary> ;
    skos:definition "Statements and expressions of individual needs and requirements should conform to an approved standard pattern and style guide or standard for writing and managing needs and requirements." ;
    skos:inScheme <https://w3id.org/cds/scheme/need-characteristics> ;
    skos:notation "C9" ;
    skos:prefLabel "Conforming" .

<https://w3id.org/cds/scheme/concept-definition>
    a skos:ConceptScheme ;
    dcterms:title "SEBoK Concept Definition reference vocabulary" ;
    owl:versionInfo "0.1.0" ;
    prov:wasDerivedFrom <https://w3id.org/cds/src/incose-gtwr-v4-summary>,
        <https://w3id.org/cds/src/sebok-v2-14> ;
    rdfs:label "Concept Definition Vocabulary" .

<https://w3id.org/cds/scheme/need-characteristics>
