# Copy to .env (gitignored) and fill in. Interop tests auto-skip when these are unset.

# OpenMBEE Flexo SysML v2 service (experimental) — the SysML v2 API & Services endpoint (roadmap T9).
# Accessed via the Open-MBEE sysmlv2-python-client: https://github.com/Open-MBEE/sysmlv2-python-client
FLEXO_SYSMLV2_URL=https://experimental.starforge.app/
FLEXO_SYSMLV2_TOKEN=Bearer <jwt>

# Flexo MMS Layer-1 (generic RDF/SPARQL round-trip) — roadmap T6.
FLEXO_BASE_URL=https://try-layer1.starforge.app
FLEXO_ORG=<org>
FLEXO_REPO=<repo>
FLEXO_TOKEN=<token>
