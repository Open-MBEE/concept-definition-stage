        "title": "ValidationError",
        "type": "object"
      },
      "VerifyRequest": {
        "description": "One model instance to check: Turtle text + whether to run cross-record checks.",
        "properties": {
          "check_conflicts": {
            "default": true,
            "title": "Check Conflicts",
            "type": "boolean"
          },
