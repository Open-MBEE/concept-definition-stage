@prefix cds: <https://w3id.org/cds#> .
@prefix cdsterm: <https://w3id.org/cds/term/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix proj: <https://cds.example/canon/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cds.example/canon/objective/coverage>
    a cds:Instance,
        cdsterm:objective ;
    cds:inSynthesis <https://cds.example/canon/synthesis/pilot> ;
    dcterms:description "Serve every district by year two." ;
    rdfs:label "City-wide coverage" .
