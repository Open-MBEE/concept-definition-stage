@prefix cds: <https://w3id.org/cds#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/cds#AuthorityKind/consulted-stakeholder>
    a skos:Concept ;
    skos:inScheme cds:AuthorityKind ;
    skos:prefLabel "consulted-stakeholder" .

<https://w3id.org/cds#AuthorityKind/curated-canon>
    a skos:Concept ;
    skos:inScheme cds:AuthorityKind ;
    skos:prefLabel "curated-canon" .

<https://w3id.org/cds#AuthorityKind/domain-expert>
    a skos:Concept ;
    skos:inScheme cds:AuthorityKind ;
    skos:prefLabel "domain-expert" .

<https://w3id.org/cds#AuthorityKind/informal>
    a skos:Concept ;
    skos:inScheme cds:AuthorityKind ;
    skos:prefLabel "informal" .

<https://w3id.org/cds#AuthorityKind/regulatory>
    a skos:Concept ;
    skos:inScheme cds:AuthorityKind ;
    skos:prefLabel "regulatory" .

<https://w3id.org/cds#AuthorityKind/sponsor>
    a skos:Concept ;
    skos:inScheme cds:AuthorityKind ;
    skos:prefLabel "sponsor" .

<https://w3id.org/cds#AuthorityKind/standard>
    a skos:Concept ;
    skos:inScheme cds:AuthorityKind ;
    skos:prefLabel "standard" .

<https://w3id.org/cds#CaptureTier/reference>
    a skos:Concept ;
    skos:inScheme cds:CaptureTier ;
    skos:prefLabel "reference" .

<https://w3id.org/cds#CaptureTier/snapshot>
    a skos:Concept ;
    skos:inScheme cds:CaptureTier ;
    skos:prefLabel "snapshot" .

<https://w3id.org/cds#RetrievalStatus/pending>
    a skos:Concept ;
    skos:inScheme cds:RetrievalStatus ;
    skos:prefLabel "pending" .

<https://w3id.org/cds#RetrievalStatus/provided>
    a skos:Concept ;
    skos:inScheme cds:RetrievalStatus ;
    skos:prefLabel "provided" .

<https://w3id.org/cds#RetrievalStatus/verified>
    a skos:Concept ;
    skos:inScheme cds:RetrievalStatus ;
    skos:prefLabel "verified" .

<https://w3id.org/cds#SourceType/image>
    a skos:Concept ;
    skos:inScheme cds:SourceType ;
    skos:prefLabel "image" .

<https://w3id.org/cds#SourceType/notes>
    a skos:Concept ;
    skos:inScheme cds:SourceType ;
    skos:prefLabel "notes" .

<https://w3id.org/cds#SourceType/pdf>
    a skos:Concept ;
    skos:inScheme cds:SourceType ;
    skos:prefLabel "pdf" .

<https://w3id.org/cds#SourceType/transcript>
    a skos:Concept ;
    skos:inScheme cds:SourceType ;
    skos:prefLabel "transcript" .

<https://w3id.org/cds#SourceType/web-page>
    a skos:Concept ;
    skos:inScheme cds:SourceType ;
    skos:prefLabel "web-page" .

<https://w3id.org/cds#VerificationMethod/checksum>
    a skos:Concept ;
    skos:inScheme cds:VerificationMethod ;
    skos:prefLabel "checksum" .

<https://w3id.org/cds#VerificationMethod/machine-visual-inspection>
    a skos:Concept ;
    skos:inScheme cds:VerificationMethod ;
    skos:prefLabel "machine-visual-inspection" .

<https://w3id.org/cds#VerificationMethod/visual-inspection>
    a skos:Concept ;
    skos:inScheme cds:VerificationMethod ;
    skos:prefLabel "visual-inspection" .

<https://w3id.org/cds>
    a owl:Ontology ;
    owl:versionInfo "0.1.0" ;
    rdfs:label "cds core vocabulary" .

cds:Authority
    a owl:Class,
        rdfs:Class ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "An entity holding authoritative content (a source's holder)." ;
    rdfs:label "Authority" ;
    rdfs:subClassOf prov:Agent .

cds:AuthorityKind
    a skos:ConceptScheme .

cds:Available
    a skos:Concept ;
    skos:inScheme cds:FrameworkRole ;
    skos:prefLabel "available" .

cds:CaptureTier
    a skos:ConceptScheme .

cds:FrameworkRole
    a skos:ConceptScheme .

cds:LifecycleModel
    a owl:Class,
        rdfs:Class ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "A system modeled across its life cycle, from Concept Definition." ;
    rdfs:label "LifecycleModel" .

cds:Required
    a skos:Concept ;
    skos:inScheme cds:FrameworkRole ;
    skos:prefLabel "required" .

cds:RetrievalActivity
    a owl:Class,
        rdfs:Class ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "The act of retrieving (capturing) a source." ;
    rdfs:label "RetrievalActivity" ;
    rdfs:subClassOf prov:Activity .

cds:RetrievalStatus
    a skos:ConceptScheme .

cds:Source
    a owl:Class,
        rdfs:Class ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "A boundary object: a specific artifact held by an authority." ;
    rdfs:label "Source" ;
    rdfs:subClassOf prov:Entity .

cds:SourceType
    a skos:ConceptScheme .

cds:Term
    a owl:Class,
        rdfs:Class ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "A Concept Definition reference-vocabulary term." ;
    rdfs:label "Term" ;
    rdfs:subClassOf skos:Concept .

cds:VerificationActivity
    a owl:Class,
        rdfs:Class ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "The act of verifying a source's content." ;
    rdfs:label "VerificationActivity" ;
    rdfs:subClassOf prov:Activity .

cds:VerificationMethod
    a skos:ConceptScheme .

cds:Waiver
    a owl:Class,
        rdfs:Class ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "An append-only, conscious acceptance of a non-Violation verify finding." ;
    rdfs:label "Waiver" .

cds:authorityKind
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "The controlled kind of an authority." ;
    rdfs:domain cds:Authority ;
    rdfs:label "authorityKind" ;
    rdfs:range skos:Concept .

cds:captureTier
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "How faithfully a source is captured (reference / snapshot)." ;
    rdfs:domain cds:Source ;
    rdfs:label "captureTier" ;
    rdfs:range skos:Concept .

cds:cites
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "Links a term to a boundary-object source it draws on." ;
    rdfs:domain cds:Term ;
    rdfs:label "cites" ;
    rdfs:range cds:Source .

cds:codeLicense
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The code license declared by a lifecycle model." ;
    rdfs:domain cds:LifecycleModel ;
    rdfs:label "codeLicense" ;
    rdfs:range dcterms:LicenseDocument .

cds:contentHash
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "The content hash (e.g. sha256:...) of a captured source." ;
    rdfs:domain cds:Source ;
    rdfs:label "contentHash" ;
    rdfs:range xsd:string .

cds:definitionSource
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The upstream attribution SEBoK records for a term's definition." ;
    rdfs:domain cds:Term ;
    rdfs:label "definitionSource" ;
    rdfs:range xsd:string .

cds:frameworkRole
    a owl:AnnotationProperty,
        rdf:Property ;
    rdfs:comment "Whether a term is Required for compliance or Available (optional)." ;
    rdfs:label "frameworkRole" .

cds:license
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The tracked SPDX license of a referenced asset (tracked, not enforced)." ;
    rdfs:domain cds:Source ;
    rdfs:label "license" ;
    rdfs:range dcterms:LicenseDocument .

cds:licenseText
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The verbatim terms of a custom license." ;
    rdfs:domain dcterms:LicenseDocument ;
    rdfs:label "licenseText" ;
    rdfs:range xsd:string .

cds:locator
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "The locator (URI or document number) of a source." ;
    rdfs:domain cds:Source ;
    rdfs:label "locator" ;
    rdfs:range xsd:string .

cds:nrmCanon
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "An INCOSE NRM / GtWR grounding note on a term." ;
    rdfs:domain cds:Term ;
    rdfs:label "nrmCanon" ;
    rdfs:range xsd:string .

cds:reproducible
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "Whether a custom license permits reproduction/redistribution." ;
    rdfs:domain dcterms:LicenseDocument ;
    rdfs:label "reproducible" ;
    rdfs:range xsd:boolean .

cds:retrievalIssue
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The retrieval-escalation issue URL for a not-yet-secured source." ;
    rdfs:domain cds:RetrievalActivity ;
    rdfs:label "retrievalIssue" ;
    rdfs:range xsd:string .

cds:retrievalStatus
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "The construction-order state of a retrieval (pending/provided/verified)." ;
    rdfs:domain cds:RetrievalActivity ;
    rdfs:label "retrievalStatus" ;
    rdfs:range skos:Concept .

cds:snapshot
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The content-addressed local snapshot filename of a captured source." ;
    rdfs:domain cds:Source ;
    rdfs:label "snapshot" ;
    rdfs:range xsd:string .

cds:sourceType
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "The controlled kind of artifact a source points at." ;
    rdfs:domain cds:Source ;
    rdfs:label "sourceType" ;
    rdfs:range skos:Concept .

cds:stage
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The life-cycle stage label of a lifecycle model." ;
    rdfs:domain cds:LifecycleModel ;
    rdfs:label "stage" ;
    rdfs:range xsd:string .

cds:sysmlConstruct
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The SysML v2 construct a term structurally anchors to." ;
    rdfs:domain cds:Term ;
    rdfs:label "sysmlConstruct" .

cds:textLicense
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The text license of a lifecycle model (gates restricted-canon rendering)." ;
    rdfs:domain cds:LifecycleModel ;
    rdfs:label "textLicense" ;
    rdfs:range dcterms:LicenseDocument .

cds:verificationMethod
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "How a source's content was confirmed (checksum/visual/machine)." ;
    rdfs:domain cds:VerificationActivity ;
    rdfs:label "verificationMethod" ;
    rdfs:range skos:Concept .

cds:verificationNote
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "Prose note on how a verification was performed." ;
    rdfs:domain cds:VerificationActivity ;
    rdfs:label "verificationNote" ;
    rdfs:range xsd:string .

cds:waiverReason
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "Why a waiver was consciously accepted." ;
    rdfs:domain cds:Waiver ;
    rdfs:label "waiverReason" ;
    rdfs:range xsd:string .

cds:waivesFocus
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The specific focus node a waiver applies to." ;
    rdfs:domain cds:Waiver ;
    rdfs:label "waivesFocus" .

cds:waivesRule
    a owl:DatatypeProperty,
        rdf:Property ;
    cds:frameworkRole cds:Available ;
    rdfs:comment "The verify rule (check name) a waiver accepts." ;
    rdfs:domain cds:Waiver ;
    rdfs:label "waivesRule" ;
    rdfs:range xsd:string .

cds:wasVerifiedBy
    a owl:ObjectProperty,
        rdf:Property ;
    cds:frameworkRole cds:Required ;
    rdfs:comment "Links a source to a verification activity performed over it." ;
    rdfs:domain cds:Source ;
    rdfs:label "wasVerifiedBy" ;
    rdfs:range cds:VerificationActivity .
